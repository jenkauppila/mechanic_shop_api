# Copy this file to .env and replace the placeholders. Never commit .env.

# Signs login tokens. Required in production; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Production database connection string (used by ProductionConfig and seed.py; dev and tests use SQLite).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Optional: Redis URL for rate limit storage in production; leave unset to use in-memory storage.
# REDIS_URL=redis://HOST:6379/0

# Optional: port for flask_app.py when run directly (defaults to 5000).
# PORT=5000
